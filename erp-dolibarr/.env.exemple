# Copiez ce fichier sous le nom .env, puis remplacez CHAQUE mot de passe.
# Ne publiez jamais le fichier .env (il est ignoré par git).

# Mot de passe de l'administrateur Dolibarr (connexion à l'ERP)
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=ChangezMoi-Admin

# Mots de passe de la base de données
MYSQL_ROOT_PASSWORD=ChangezMoi-Root
MYSQL_PASSWORD=ChangezMoi-Base

# Adresse à laquelle l'ERP sera ouvert (exemple : http://192.168.1.20:8080)
DOLI_URL_ROOT=http://localhost:8080
PORT=8080
